<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Floating window -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Screen capture via MediaProjection does not need extra, but for compatibility -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />

    <application
        android:name=".ScannerApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_scan"
        android:roundIcon="@drawable/ic_scan"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TradeScanner">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TradeScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MediaProjectionPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Foreground service for scanning + floating window -->
        <service
            android:name=".service.FloatingScannerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="screenScanningAndFloatingOverlay" />
        </service>

        <!-- Accessibility service for MT5 automation -->
        <service
            android:name=".service.TradeScannerAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
